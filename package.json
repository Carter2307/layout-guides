{
  "name": "@roger.b/layout-guide",
  "version": "0.1.0",
  "description": "Layout guide overlay: grid, columns and rows guides driven by a floating configuration panel.",
  "license": "MIT",
  "author": "B.ROGER <remirjunior1999@gmail.com>",
  "homepage": "https://github.com/Carter2307/layout-guides#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carter2307/layout-guides.git"
  },
  "bugs": {
    "url": "https://github.com/Carter2307/layout-guides/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.15.1",
  "keywords": [
    "react",
    "layout",
    "grid",
    "columns",
    "rows",
    "guides",
    "overlay",
    "design",
    "devtool",
    "figma",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "vite build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
